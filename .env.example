#   cp .env.example .env        (Windows: copy .env.example .env)
# El archivo .env NO se sube a Git (está en .gitignore).

# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=pon-tu-clave-aqui

# Opcional. "gemini-flash-latest" apunta al Flash más reciente.
# Si da error de modelo/cuota, mira en AI Studio cuál está disponible en el plan gratis.
GEMINI_MODEL=gemini-flash-latest
